@model Microsoft.AspNetCore.Identity.IdentityUser

@{
    ViewData["Title"] = "Supprimer un utilisateur";
}

<div class="container mt-5">
    <h2>Supprimer un utilisateur</h2>
    <hr />

    <div class="alert alert-warning" role="alert">
        <strong>Attention !</strong> Vous êtes sur le point de supprimer définitivement l'utilisateur.
    </div>

    <div class="card">
        <div class="card-body">
            <p><strong>Email :</strong> @Model.Email</p>
            <p><strong>Nom d'utilisateur :</strong> @Model.UserName</p>
        </div>
    </div>

    <form method="post" asp-action="Delete" class="mt-4">
        <input type="hidden" name="id" value="@Model.Id" />
        
        <button type="submit" class="btn btn-danger">
            Confirmer la suppression
        </button>
        <a href="/users/list" class="btn btn-secondary">
            Annuler
        </a>
    </form>
</div>
