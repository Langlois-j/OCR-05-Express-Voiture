@model OCR_05_Express_Voiture.Models.Entities.CarBrand

@{
    ViewData["Title"] = "Supprimer une marque";
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <!-- Main Content -->
    <div class="main-container">
        <!-- Page Title -->
        <h1 class="page-title">@ViewData["Title"]</h1>
        <p class="page-subtitle">Êtes-vous sûr de vouloir supprimer cette marque ?</p>

        <div class="car-card" style="max-width: 600px;">
            <div class="car-info">
                <div class="car-price">
                    @Model.Name
                </div>

                <!-- Form -->
                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <div class="car-actions">
                        <button type="submit" class="btn-delete">Confirmer la suppression</button>
                        <a href="/carbrands" class="btn-details" style="background-color: #6c757d;">Annuler</a>
                    </div>
                </form>
            </div>
        </div>

        <a href="/carbrands" class="back-link">Retour à la liste</a>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
