@model OCR_05_Express_Voiture.Models.Entities.CarBrand

@{
    ViewData["Title"] = "Ajouter une marque";
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>

    <div class="container-form">
        <!-- Page Title -->
        <h1 class="page-title">@ViewData["Title"]</h1>
        <p class="page-subtitle">Les champs marqués * sont obligatoires</p>

        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- Nom de la marque -->
            <div class="form-group">
                <label asp-for="Name" class="control-label">Nom de la marque *</label>
                <input asp-for="Name" class="form-control" type="text" placeholder="Ex: Toyota, Peugeot, BMW" required />
                <span asp-validation-for="Name" class="form-validation"></span>
            </div>

            <!-- Bouton Publier -->
            <button type="submit" class="btn-submit">Publier</button>
        </form>

        <a href="/carbrands" class="back-link">Retour à la liste</a>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
</body>
</html>
