@model OCR_05_Express_Voiture.Models.Entities.CarBrand

@{
    ViewData["Title"] = "Détails de la marque";
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <!-- Main Content -->
    <div class="main-container">
        <!-- Page Title -->
        <h1 class="page-title">@ViewData["Title"]</h1>

        <div class="car-card" style="max-width: 600px;">
            <div class="car-info">
                <div class="car-price">
                    @Model.Name
                </div>

                <!-- Actions -->
                <div class="car-actions">
                    <a href="/carbrands/edit/@Model.Id" class="btn-details" style="background-color: #6c757d;">Modifier</a>
                    <a href="/carbrands/delete/@Model.Id" class="btn-delete">Supprimer</a>
                </div>
            </div>
        </div>

        <a href="/carbrands" class="back-link">Retour à la liste</a>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
