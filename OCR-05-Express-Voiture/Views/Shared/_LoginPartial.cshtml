@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<ul class="navbar-nav">
    <li class="nav-item">
        @* <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Accueil</a> *@
        <form class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
            <button type="submit" class="nav-link btn ">Accueil</button>
        </form>
    </li>
@if (SignInManager.IsSignedIn(User))
{
   <li class="nav-item">
       @*  <a  class="nav-link" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">Mon compte</a> *@
            <form class="nav-link" asp-area="Identity" asp-page="/Account/Manage/Index">
                <button type="submit" class="nav-link btn ">Mon compte</button>
            </form>
    </li>
        <li class="nav-item">
            @* <a class="nav-link" asp-area="Identity" asp-page="/Account/Manage/Index" title="Parametres">Paramètres</a> *@
            <form class="nav-link" asp-area="Identity" asp-page="/Account/Manage/Index">
                <button type="submit" class="nav-link btn ">Paramètres</button>
            </form>
        </li>

    <li class="nav-item">
            <form class="nav-link" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
             <button  type="submit" class="nav-link btn ">Se déconnecter</button> 
        </form>
    </li>
}
else
{
    <li class="nav-item">
           @*  <a class="nav-link" asp-area="Identity" asp-page="/Account/Login">Se connecter</a> *@
            <form class="nav-link" asp-area="Identity" asp-page="/Account/Login">
                <button type="submit" class="nav-link btn ">Se connecter</button>
            </form>
    </li>
}
</ul>
