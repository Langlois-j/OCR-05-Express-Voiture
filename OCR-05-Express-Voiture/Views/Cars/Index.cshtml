    </style>  
</head>
<body>
    <!-- Main Content -->
    <div class="main-container">
        <!-- Page Title -->
        <h1 class="page-title">Nos voitures</h1>
        @if (SignInManager.IsSignedIn(User))
{
        <!-- Button Section -->
        <div class="button-section">
            <a href="/cars/create" class="btn-submit">+ Ajouter une voiture</a>
        </div>
}
}
        <!-- Cars Grid -->
        @if (Model != null && Model.Any())
        {
            <div class="cars-grid">
                @foreach (var car in Model)
                {
                    <div class="car-card">
                        <!-- Car Image -->
                        <img src="@(string.IsNullOrEmpty(car.ImagePath) ? "/images/placeholder-car.jpg" : car.ImagePath)" 
                             alt="@car.Brand?.Name @car.Model?.Name" 
                             class="car-image" />

                        <!-- Car Info -->
                        <div class="car-info">
                            <div class="car-price">
                                Prix de vente: @car.RepairAmount.ToString("C2")
                            </div>

                            <div class="car-details">
                                <div class="car-details-item">
                                    <span class="car-details-label">Année:</span> @car.ConstructionYear
                                </div>
                                <div class="car-details-item">
                                    <span class="car-details-label">Marque:</span> @car.Brand?.Name
                                </div>
                                <div class="car-details-item">
                                    <span class="car-details-label">Modèle:</span> @car.Model?.Name
                                </div>
                                <div class="car-details-item">
                                    <span class="car-details-label">Finition:</span> @(car.TrimLevel ?? "Non spécifiée")
                                </div>
                                <div class="car-details-item">
                                    <span class="car-details-label">Kilométrage:</span> @car.Mileage km
                                </div>
                            </div>

                            <!-- Actions -->
                            <div class="car-actions">
                                <a href="/cars/details/@car.Id" class="btn-details">Voir détails</a>
                                @if (SignInManager.IsSignedIn(User))
                                    {
                                        <a href="/cars/edit/@car.Id" class="btn-details" style="background-color: #6c757d;">Modifier</a>
                                        <a href="/cars/delete/@car.Id" class="btn-delete">Supprimer</a>
                                    }
                                    
                                </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <p>Aucune voiture disponible pour le moment.</p>
                @if (SignInManager.IsSignedIn(User))
                    {
                        <a href="/cars/create" class="btn-add-car">Ajouter la première voiture</a>
                    }
                </div>
        }
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
