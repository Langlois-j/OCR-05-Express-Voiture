@model OCR_05_Express_Voiture.Models.Entities.Car

@{
    ViewData["Title"] = "Ajouter une voiture";
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />

</head>
<body>

    <div class="container-form">
        <!-- Page Title -->
        <h1 class="page-title">Ajouter une voiture</h1>
        <p class="page-subtitle">Les champs marqués * sont obligatoires</p>

        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
           @*  <!-- Marque -->
            <div class="form-group">
                <label asp-for="CarBrandId" class="control-label">Marque</label>
                <select asp-for="CarBrandId" id="brandSelect" class="form-control" asp-items="ViewBag.CarBrandId">
                    <option value="">-- Sélectionnez une marque --</option>
                </select>
                <span asp-validation-for="CarBrandId" class="form-validation"></span>
            </div>

            <!-- Modèle -->
            <div class="form-group">
                <label asp-for="CarModelId" class="control-label">Modèle</label>
                <select asp-for="CarModelId" id="modelSelect" class="form-control">
                    <option value="">-- Sélectionnez d'abord une marque --</option>
                </select>
                <span asp-validation-for="CarModelId" class="form-validation"></span>
            </div> *@

            <!-- Marque -->
            <div class="form-group">
                <label asp-for="CarBrandId" class="control-label">Marque</label>
                <select asp-for="CarBrandId" class="form-control" asp-items="ViewBag.CarBrandId">
                    <option value="">-- Sélectionnez une marque --</option>
                </select>
                <span asp-validation-for="CarBrandId" class="form-validation"></span>
            </div>
            <!-- Modèle -->
            <div class="form-group">
                <label asp-for="CarModelId" class="control-label">Modèle</label>
                <select asp-for="CarModelId" class="form-control" asp-items="ViewBag.CarModelId">
                    <option value="">-- Sélectionnez un modèle --</option>
                </select>
                <span asp-validation-for="CarModelId" class="form-validation"></span>
            </div>

            <!-- Finition -->
            <div class="form-group">
                <label asp-for="TrimLevel" class="control-label">Finition</label>
                <input asp-for="TrimLevel" class="form-control" type="text" placeholder="Ex: Luxe, Sport, Économique" />
                <span asp-validation-for="TrimLevel" class="form-validation"></span>
            </div>

            <!-- Année -->
            <div class="form-group">
                <label asp-for="ConstructionYear" class="control-label">Année</label>
                <input asp-for="ConstructionYear" class="form-control" type="number" placeholder="Entrez l'année de construction" />
                <span asp-validation-for="ConstructionYear" class="form-validation"></span>
            </div>


            <!-- Kilométrage -->
            <div class="form-group">
                <label asp-for="Mileage" class="control-label">Kilométrage</label>
                <input asp-for="Mileage" class="form-control" type="number" placeholder="Entrez le kilométrage" />
                <span asp-validation-for="Mileage" class="form-validation"></span>
            </div>

            <!-- VIN Code (caché mais requis) -->
            <div class="form-group">
                <label asp-for="VinCode" class="control-label">Code VIN</label>
                <input asp-for="VinCode" class="form-control" type="text" placeholder="Entrez le code VIN" />
                <span asp-validation-for="VinCode" class="form-validation"></span>
            </div>

            <!-- Image -->
            <div class="form-group">
                <label class="control-label">Visuel</label>
                <div class="image-upload-wrapper" onclick="document.getElementById('imageInput').click();">
                    <div style="display: flex; align-items: center; justify-content: center;">
                        <button type="button" class="upload-button">+</button>
                        <span class="upload-text">Joindre une image</span>
                    </div>
                    <input id="imageInput" asp-for="ImagePath" type="file" accept="image/*" />
                </div>
                <span asp-validation-for="ImagePath" class="form-validation"></span>
            </div>

            <!-- Description des réparations -->
            <div class="form-group">
                <label asp-for="RepairDescription" class="control-label">Description des réparations</label>
                <textarea asp-for="RepairDescription" class="form-control" rows="4" placeholder="Décrivez les réparations effectuées ou l'état du véhicule"></textarea>
                <span asp-validation-for="RepairDescription" class="form-validation"></span>
            </div>
            <!-- Montant réparation -->
            <div class="form-group">
                <label asp-for="RepairAmount" class="control-label">Monant réparations</label>
                <input asp-for="RepairAmount" class="form-control" type="number" step="0.01" placeholder="Entrez le prix" />
                <span asp-validation-for="RepairAmount" class="form-validation"></span>
            </div>
            <!-- État de la voiture -->
            <div class="form-group">
                <label class="control-label">Paramétres</label>
                <div class="checkbox-group">
                    <label>
                        <input asp-for="ForSell" type="checkbox" /> Visible sur le site
                    </label>
                    <label>
                        <input asp-for="Sold" type="checkbox" /> Vendue
                    </label>
                </div>
            </div>

            <!-- Bouton Publier -->
            <button type="submit" class="btn-submit">Publier</button>
        </form>

        <a href="/cars" class="back-link">Retour à la liste</a>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
