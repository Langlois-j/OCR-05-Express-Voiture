@model OCR_05_Express_Voiture.Models.Entities.Car

@{
    bool isEdit = Model?.Id != 0;
    ViewData["Title"] = isEdit ? "Modifier une voiture" : "Ajouter une voiture";
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>

    <div class="container-form">
        <!-- Page Title -->
        <h1 class="page-title">@ViewData["Title"]</h1>
        <p class="page-subtitle">Les champs marqués * sont obligatoires</p>

        <form asp-action="@(isEdit ? "Edit" : "Create")" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            @if (isEdit)
            {
                <input type="hidden" asp-for="Id" />
            }

            <!-- Marque -->
            <div class="form-group">
                <label asp-for="BrandId" class="control-label">Marque *</label>
                <select asp-for="BrandId" id="BrandId" class="form-control" asp-items="ViewBag.BrandId" required>
                    <option value="">-- Sélectionnez une marque --</option>
                </select>
                <span asp-validation-for="BrandId" class="form-validation"></span>
            </div>

            <!-- Modèle -->
            <div class="form-group">
                <label asp-for="ModelId" class="control-label">Modèle *</label>
                <select asp-for="ModelId" class="form-control" asp-items="ViewBag.ModelId" required>
                    <option value="">-- Sélectionnez un modèle --</option>
                </select>
                <span asp-validation-for="ModelId" class="form-validation"></span>
            </div>

            <!-- Finition -->
            <div class="form-group">
                <label asp-for="TrimLevel" class="control-label">Finition</label>
                <input asp-for="TrimLevel" class="form-control" type="text" placeholder="Ex: Luxe, Sport, Économique" />
                <span asp-validation-for="TrimLevel" class="form-validation"></span>
            </div>

            <!-- Année -->
            <div class="form-group">
                <label asp-for="ConstructionYear" class="control-label">Année</label>
                <input asp-for="ConstructionYear" class="form-control" type="number" placeholder="Entrez l'année de construction" />
                <span asp-validation-for="ConstructionYear" class="form-validation"></span>
            </div>


            <!-- Kilométrage -->
            <div class="form-group">
                <label asp-for="Mileage" class="control-label">Kilométrage</label>
                <input asp-for="Mileage" class="form-control" type="number" placeholder="Entrez le kilométrage" />
                <span asp-validation-for="Mileage" class="form-validation"></span>
            </div>

            <!-- VIN Code (caché mais requis) -->
            <div class="form-group">
                <label asp-for="VinCode" class="control-label">Code VIN</label>
                <input asp-for="VinCode" class="form-control" type="text" placeholder="Entrez le code VIN" />
                <span asp-validation-for="VinCode" class="form-validation"></span>
            </div>

            <!-- Image -->
            <div class="form-group">
                <label class="control-label">Visuel</label>
                <div class="image-upload-wrapper" onclick="document.getElementById('imageInput').click();">
                    <div style="display: flex; align-items: center; justify-content: center;">
                        <button type="button" class="upload-button">+</button>
                        <span class="upload-text" id="fileName">Joindre une image</span>
                    </div>
                    <input id="imageInput" name="imageFile" type="file" accept="image/*" onchange="previewImage(this)" />
                </div>

                <!-- Aperçu de l'image -->
                <div id="imagePreview" style="margin-top: 15px; display: none;">
                    <img id="previewImg" src="" alt="Aperçu" style="max-width: 100%; max-height: 300px; border-radius: 4px; border: 1px solid var(--border-color);" />
                </div>

                @if (Model?.ImagePath != null && !string.IsNullOrEmpty(Model.ImagePath))
                {
                    <div id="currentImage" style="margin-top: 15px;">
                        <small class="text-muted">Image actuelle :</small><br />
                        <img src="@Model.ImagePath" alt="Image actuelle" style="max-width: 100%; max-height: 300px; margin-top: 5px; border-radius: 4px; border: 1px solid var(--border-color);" />
                    </div>
                }
                <input type="hidden" asp-for="ImagePath" />
            </div>

            <script>
                function previewImage(input) {
                    const fileName = input.files[0]?.name || 'Joindre une image';
                    document.getElementById('fileName').textContent = fileName;

                    // Afficher l'aperçu de l'image
                    if (input.files && input.files[0]) {
                        const reader = new FileReader();

                        reader.onload = function(e) {
                            document.getElementById('previewImg').src = e.target.result;
                            document.getElementById('imagePreview').style.display = 'block';

                            // Cacher l'image actuelle si elle existe
                            const currentImage = document.getElementById('currentImage');
                            if (currentImage) {
                                currentImage.style.display = 'none';
                            }
                        };

                        reader.readAsDataURL(input.files[0]);
                    }
                }
            </script>

            <!-- Description des réparations -->
            <div class="form-group">
                <label asp-for="RepairDescription" class="control-label">Description des réparations</label>
                <textarea asp-for="RepairDescription" class="form-control" rows="4" placeholder="Décrivez les réparations effectuées ou l'état du véhicule"></textarea>
                <span asp-validation-for="RepairDescription" class="form-validation"></span>
            </div>
            <!-- Prix de vente -->
            <div class="form-group">
                <label asp-for="RepairAmount" class="control-label">Prix de vente</label>
                <input asp-for="RepairAmount" class="form-control" type="number" step="0.01" placeholder="Entrez le prix" />
                <span asp-validation-for="RepairAmount" class="form-validation"></span>
            </div>
            <!-- État de la voiture -->
            <div class="form-group">
                <label class="control-label">Paramétres</label>
                <div class="checkbox-group">
                    <label>
                        <input asp-for="ForSell" type="checkbox" /> Visible sur le site
                    </label>
                    <label>
                        <input asp-for="Sold" type="checkbox" /> Vendue
                    </label>
                </div>
            </div>

            <!-- Bouton Publier / Modifier -->
            <button type="submit" class="btn-submit">@(isEdit ? "Modifier" : "Publier")</button>
        </form>

        <a href="/cars" class="back-link">Retour à la liste</a>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        $(document).ready(function () {
            // Fonction pour charger les modèles selon la marque
            function loadModels(brandId, selectedModelId) {
                var modelSelect = $('#ModelId');

                modelSelect.empty();
                modelSelect.append('<option value="">-- Chargement... --</option>');
                modelSelect.prop('disabled', true);

                if (brandId) {
                    $.ajax({
                        url: '@Url.Action("GetModelsByBrand", "Cars")',
                        type: 'GET',
                        data: { brandId: brandId },
                        success: function (data) {
                            modelSelect.empty();

                            if (data.length > 0) {
                                modelSelect.append('<option value="">-- Sélectionnez un modèle --</option>');
                                $.each(data, function (i, model) {
                                    var option = $('<option></option>')
                                        .val(model.id)
                                        .text(model.name);

                                    // ✅ Pré-sélectionne la valeur si c'est une édition
                                    if (model.id == selectedModelId) {
                                        option.attr('selected', 'selected');
                                    }

                                    modelSelect.append(option);
                                });
                                modelSelect.prop('disabled', false);
                            } else {
                                modelSelect.append('<option value="">-- Aucun modèle disponible --</option>');
                            }
                        },
                        error: function () {
                            modelSelect.empty();
                            modelSelect.append('<option value="">-- Erreur de chargement --</option>');
                            alert('Erreur lors du chargement des modèles');
                        }
                    });
                } else {
                    modelSelect.empty();
                    modelSelect.append('<option value="">-- Sélectionnez d\'abord une marque --</option>');
                }
            }

            // ✅ CHARGE LES MODÈLES AU CHARGEMENT DE LA PAGE
            var initialBrandId = $('#BrandId').val();
            var initialModelId = $('#ModelId').val();  // ✅ Récupère la valeur du ModelId

            if (initialBrandId) {
                loadModels(initialBrandId, initialModelId);  // ✅ Passe le ModelId
            }

            // Quand on change la marque
            $('#BrandId').change(function () {
                var brandId = $(this).val();
                loadModels(brandId, null);  // Aucune pré-sélection lors du changement
            });
        });
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
</body>
</html>
